
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ensure Backend Running",
            "type": "process",
            "command": "node",
            "args": [
                "${workspaceFolder}/backend/scripts/ensure-backend.cjs"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^BACKEND_READY$",
                    "file": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting Type and Run backend",
                    "endsPattern": "BACKEND_READY"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "showReuseMessage": false
            }
        }
    ]
}
