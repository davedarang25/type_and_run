{
  "name": "type-and-run-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Type-to-Run REST API (Express + MySQL) shared by react_game and flutter_game",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:reset": "node scripts/resetDb.js",
