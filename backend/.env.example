PORT=3000

# MySQL / MariaDB (XAMPP defaults shown)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=type_and_run

# Long random string; used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API (React dev server, Flutter web)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
