PORT=3000

# MySQL / MariaDB (XAMPP defaults shown)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=type_and_run

# Long random string; used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Browsers on localhost / your local network (any port) are allowed automatically,
# so react_game and flutter_game work out of the box. Add deployed site URLs here:
CORS_ORIGIN=
# Set to false in production to allow ONLY the origins above:
CORS_ALLOW_LOCAL=true
